{
  "name": "stellar-payment-platform",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "tsx watch server.js",
    "test": "jest --forceExit --maxWorkers=2",
    "test:integration": "TEST_API_URL=http://localhost:5001 jest --forceExit --testPathPattern=integration",
    "test:load": "artillery run artillery.yml",
    "listener": "node horizonListener.js",
    "db:seed": "node scripts/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.68.0",
    "@stellar/stellar-sdk": "^16.0.1",
    "bad-words": "^3.0.4",
    "compression": "^1.8.1",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "generic-pool": "^3.9.0",
    "helmet": "^8.3.0",
    "json2csv": "5.0.7",
    "node-cache": "^5.1.2",
    "node-cron": "4.5.0",
    "pdfkit": "^0.15.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "tsx": "4.23.1"
  }
}
